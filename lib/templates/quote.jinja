<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="UTF-8" />
    <title>title</title>

    <style>
        @font-face {
            font-family: "Figtree";
            src: url("data:font/ttf;base64,{{ font_base64 }}") format("truetype");
            font-style: normal;
            font-weight: 300 900;
        }

        html,
        body {
            width: 1200px;
            height: 600px;
            margin: 0;
            padding: 0;
            color: white;
            background-color: black;
            font-family: "Figtree", "Noto Sans JP", "Noto Sans SC", "Noto Sans TC", "Noto Sans KR", "Noto Color Emoji", sans-serif;
            font-optical-sizing: auto;
            font-weight: 500;
            font-style: normal;
            font-size: 37px;
            overflow: hidden;
        }

        body {
            display: flex;
        }

        p,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            margin: 0;
            padding: 0;
        }

        section {
            flex: 1 1 50%;
            max-width: 50%;
        }

        .quote {
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow: hidden;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
            gap: 10px;
        }

        .content {
            margin-top: auto;
            height: fit-content;
            font-size: inherit;
            line-height: 1.15;
            overflow: hidden;
            word-break: normal;
            overflow-wrap: break-word;
            hyphens: manual;
            text-align: center;
            width: 100%;
            white-space: pre-wrap;
        }

        .content img {
            height: 1.2em;
            width: auto;
            object-fit: contain;
            vertical-align: middle;
        }

        .content img:not([src]),
        .content img[src=""],
        .content img[src*="undefined"],
        .content img:error {
            display: none;
        }

        .content img:not([src])::after,
        .content img[src=""]::after,
        .content img[src*="undefined"]::after,
        .content img:error::after {
            content: attr(alt);
            display: inline;
        }

        .fade-bottom {
            position: relative;
        }

        .fade-bottom::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 100px;
            background: linear-gradient(to bottom, transparent, black 90%);
        }

        .author {
            font-size: min(1em, 30px);
            font-weight: 400;
        }

	    .footer {
            font-size: 23px;
            font-weight: 500;
            margin-top: auto;
        }
    </style>

    {% if fade %}
    <style>
        .avatar {
            img {
                mask-image: linear-gradient(to left,
                        rgba(0, 0, 0, 0) 0%,
                        rgba(0, 0, 0, 1) 100%);
            }
        }
    </style>
    {% endif %}

    {% if bw_mode %}
    <style>
        img {
            filter: grayscale(100%);
        }
    </style>
    {% endif %}

    {% if light_mode %}
    <style>
        body {
            background-color: white !important;
            color: black !important;
        }

        .fade-bottom::after {
            background: linear-gradient(to bottom, transparent, white 90%) !important;
        }
    </style>
    {% endif %}

    {% if light_mode and fade %}
    <style>
        .avatar {
            img {
                mask-image: linear-gradient(to left,
                        rgba(255, 255, 255, 0) 0%,
                        rgba(255, 255, 255, 1) 100%) !important;
            }
        }
    </style>
    {% endif %}
</head>

<body>
    <section class="avatar">
        <img src="{{ user_pfp }}" alt="Failed to load avatar" style="width: 100%; height: 100%" />
    </section>
    <section class="quote">
        <h1 class="content">{{ content|safe }}</h1>

        <div class="author">
            {% if nickname %}
            <p>- {{ user.display_name }}</p>
            <p style="color: #808080">@{{ user.name }}</p>
            {% else %}
            <p style="color: #808080">- @{{ user.name }}</p>
            {% endif %}
        </div>

        <div class="footer">
            {% if custom_quote %}
            <p style="color: red !important;">
                Custom Quote by @{{ custom_quote_user.name }}
            </p>
            {% elif is_bot %}
            <p style="color: red !important;">Bot or Webhook Message</p>
            {% endif %}

            <p>https://titanium.fyi</p>
        </div>
    </section>

    <script>
        function fitTextToContainer(contentElement, authorElement, minFontSize = 22, maxFontSize = 56) {
            const quoteElement = document.querySelector(".quote");
            const styles = window.getComputedStyle(quoteElement);
            
            const verticalPadding = parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
            const gap = parseFloat(styles.gap) || 0;
            
            const fixedContentHeight = authorElement.offsetHeight + document.querySelector(".footer").offsetHeight + (gap * 2);
            const maxContentHeight = quoteElement.clientHeight - verticalPadding - fixedContentHeight;
            
            let low = minFontSize;
            let high = maxFontSize;
            let mid;

            let bestFit = minFontSize;

            while (low <= high) {
                mid = Math.floor((low + high) / 2);
                document.body.style.fontSize = mid + 'px';

                if (contentElement.scrollHeight <= maxContentHeight) {
                    // fits, try a bigger size
                    bestFit = mid;
                    low = mid + 1;
                } else {
                    // doesn't fit, try a smaller size
                    high = mid - 1;
                }
            }

            document.body.style.fontSize = bestFit + 'px';
            contentElement.style.maxHeight = maxContentHeight + 'px';

            // add fade if required
            if (bestFit === minFontSize && contentElement.scrollHeight > contentElement.clientHeight) {
                contentElement.classList.add("fade-bottom");
                authorElement.style.transform = "translateY(-10px)";
            }
        }

        document.fonts.ready.then(function() {
            const contentElement = document.querySelector(".content");
            const authorElement = document.querySelector(".author");

            if (contentElement && authorElement) {
                fitTextToContainer(contentElement, authorElement);
            }
            
            document.body.classList.add("ready");
        });
    </script>
</body>

</html>
